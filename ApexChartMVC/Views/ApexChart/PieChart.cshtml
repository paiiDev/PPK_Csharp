@model ChartModel


<div id="chart"></div>



@section Scripts {
    <script>

        const _series = @Html.Raw(Json.Serialize(Model.Series));
        const _lables = @Html.Raw(Json.Serialize(Model.Labels));

        var options = {
          series: _series,
          chart: {
          width: 380,
          type: 'pie',
        },
        labels: _lables,
        responsive: [{
          breakpoint: 480,
          options: {
            chart: {
              width: 200
            },
            legend: {
              position: 'bottom'
            }
          }
        }]
        };

        var chart = new ApexCharts(document.querySelector("#chart"), options);
        chart.render();
    </script>
}
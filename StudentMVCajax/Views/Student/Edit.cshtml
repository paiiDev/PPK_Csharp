@model EditStudentRequestDto;

@{
    ViewData["Title"] = "Edit";
}

<h2 class="text-center my-5">Edit Student</h2>



<form method="post">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <input type="hidden" asp-for="Id" id="studentId" />

            <div class="mb-3">
                <label>Student Name</label>
                <input asp-for="Name" id="studentName" type="text" class="form-control form-control-lg" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Age</label>
                <input asp-for="Age" id="studentAge" type="number" class="form-control form-control-lg" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <button type="submit" id="saveBtn" class="btn btn-primary w-100 h-25">
                Save Student
            </button>

        </div>
    </div>
</form>
   

    @section Scripts {

        <partial name="_ValidationScriptsPartial" />    

        <script>
            $('#saveBtn').click(function(e) {

                e.preventDefault();
               
                
                var data = {
                    Id: $('#studentId').val(),
                    Name: $('#studentName').val(),
                    Age: $('#studentAge').val()
                };
                $.ajax({
                    url: '/Student/EditAjax',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(response) {
                        
                        if (response.isSuccess) {
                            localStorage.setItem("alertMessage", response.message);
                            localStorage.setItem("alertType", "success");
                            window.location.replace('/Student/Index');
                        } 
                    },
                    error: function() {
                            localStorage.setItem("alertMessage", "Student update fail!");
                            localStorage.setItem("alertType", "false"); 
                    }
                });
        });
        </script>
    }
